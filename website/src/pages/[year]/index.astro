import Layout from "@/layouts/layout.astro";
import { getCollection, render } from "astro:content";
import ArrowRight from "@/assets/arrow-right.svg";
import GroupPhoto from "@/assets/group-photo-1.jpg";

export async function getStaticPaths() {
  const years = await getCollection("years");
  return years.map((year) => ({
    params: { year: year.data.year.toString() },
    props: { year },
  }));
}

const { year } = Astro.props;
const { Content } = await render(year);

// Get participants and projects for this year using ID pattern matching
const participants = await getCollection("participants", ({ id }) =>
  id.startsWith(`${year.data.year}/`)
);
const projects = await getCollection("projects", ({ id }) =>
  id.startsWith(`${year.data.year}/`)
);

<Layout
  title={`${year.data.title} - Haystack Labs`}
  description={year.data.description || `Information about ${year.data.title}`}
>
  <!-- Hero Section -->
  <section class="hero-section">
    <div class="hero-background">
      <img
        src={GroupPhoto.src}
        alt="Haystack Labs group photo"
        class="hero-image"
      />
      <div class="hero-overlay"></div>
    </div>
    <div class="wrapper">
      <div class="hero-content">
        <h1 class="title">Haystack Labs {year.data.title}</h1>
        <div class="year-dates">
          <time datetime={year.data.start.toISOString()}>
            {
              year.data.start.toLocaleDateString("en-US", {
                month: "long",
                day: "numeric",
                year: "numeric",
              })
            }
          </time>
          <span class="date-separator">—</span>
          <time datetime={year.data.end.toISOString()}>
            {
              year.data.end.toLocaleDateString("en-US", {
                month: "long",
                day: "numeric",
                year: "numeric",
              })
            }
          </time>
        </div>
      </div>
    </div>
  </section>

  <!-- Content Section -->
  <section class="content-section">
    <div class="wrapper">
      <div class="year-description">
        <Content />
      </div>

      <div class="stats-overview">
        <div class="stat-card">
          <div class="stat-number">{participants.length}</div>
          <div class="stat-label">Participants</div>
        </div>
        <div class="stat-card">
          <div class="stat-number">{projects.length}</div>
          <div class="stat-label">Projects</div>
        </div>
      </div>

      <div class="main-grid">
        {
          participants.length > 0 && (
            <section class="participants">
              <div class="section-header">
                <h2 class="section-title">Participants</h2>
                <a
                  href={`/${year.data.year}/participants`}
                  class="view-all-link"
                >
                  View All
                  <ArrowRight width="16" height="16" fill="currentColor" />
                </a>
              </div>
              <div class="participants-grid">
                {participants.slice(0, 6).map((participant) => {
                  const participantSlug = participant.id.split("/").pop();
                  return (
                    <a
                      href={`/${year.data.year}/participants/${participantSlug}`}
                      class="participant-card"
                    >
                      <div class="card-content">
                        <h3 class="participant-name">
                          {participant.data.name}
                        </h3>
                        <div class="card-arrow">
                          <ArrowRight
                            width="16"
                            height="16"
                            fill="currentColor"
                          />
                        </div>
                      </div>
                    </a>
                  );
                })}
              </div>
            </section>
          )
        }

        {
          projects.length > 0 && (
            <section class="projects">
              <div class="section-header">
                <h2 class="section-title">Projects</h2>
                <a href={`/${year.data.year}/projects`} class="view-all-link">
                  View All
                  <ArrowRight width="16" height="16" fill="currentColor" />
                </a>
              </div>
              <div class="projects-grid">
                {projects.slice(0, 6).map((project) => {
                  const projectSlug = project.id.split("/").pop();
                  return (
                    <a
                      href={`/${year.data.year}/projects/${projectSlug}`}
                      class="project-card"
                    >
                      <div class="card-content">
                        <div class="header">
                          <h3>{project.data.title}</h3>
                          <div class="card-arrow">
                            <ArrowRight
                              width="20"
                              height="20"
                              fill="currentColor"
                            />
                          </div>
                        </div>

                        {project.data.category && (
                          <div class="meta">
                            <span class="category">
                              {project.data.category}
                            </span>
                          </div>
                        )}

                        {project.data.tags && project.data.tags.length > 0 && (
                          <div class="tags">
                            {project.data.tags
                              .slice(0, 3)
                              .map((tag: string) => (
                                <span class="tag">{tag}</span>
                              ))}
                          </div>
                        )}
                      </div>
                    </a>
                  );
                })}
              </div>
            </section>
          )
        }
      </div>
    </div>
  </section>
</Layout>

