---
import { getCollection, render } from "astro:content";
import Layout from "@/layouts/layout-project.astro";
import ArrowRight from "@/assets/arrow-right.svg";

export async function getStaticPaths() {
  const projects = await getCollection("projects");
  return projects.map((project) => {
    const [year, , projectSlug] = project.id.split("/");
    return {
      params: {
        year: year,
        project: projectSlug,
      },
      props: { project, year },
    };
  });
}

const { project, year } = Astro.props;
const { Content } = await render(project);

// Get related participants for this project
const allParticipants = await getCollection("participants", ({ id }) =>
  id.startsWith(`${year}/`)
);

// Filter participants that are working on this project
const projectSlug = project.id.split("/").pop() || "";
const relatedParticipants = allParticipants.filter((participant) =>
  participant.data.projects?.includes(projectSlug)
);
---

<Layout
  title={`${project.data.title} - Haystack Labs ${year}`}
  description={`Information about ${project.data.title} from Haystack Labs ${year}`}
>
  <section class="section section-xs">
    <div class="wrapper">
      <nav class="breadcrumb">
        <a href={`/${year}`}>{year}</a>
        <span class="separator">/</span>
        <a href={`/${year}/projects`}>Projects</a>
        <span class="separator">/</span>
        <span class="current">{project.data.title}</span>
      </nav>

      <header class="project-header">
        <h1 class="project-title">{project.data.title}</h1>
        <div class="project-meta">
          <span class="project-year">Haystack Labs {year}</span>
          {
            project.data.category && (
              <span class="project-category">{project.data.category}</span>
            )
          }
        </div>
      </header>

      <!-- Project Metadata -->
      <div class="project-meta-section">
        <!-- Related Participants -->
        {
          relatedParticipants.length > 0 && (
            <div class="meta-card">
              <h3 class="meta-label">Contributors</h3>
              <div class="participants-list">
                {relatedParticipants.map((participant) => {
                  const participantSlug = participant.id.split("/").pop();
                  return (
                    <a
                      href={`/${year}/participants/${participantSlug}`}
                      class="participant-link"
                    >
                      {participant.data.name}
                    </a>
                  );
                })}
              </div>
            </div>
          )
        }

        <!-- Tools -->
        {
          project.data.tools && project.data.tools.length > 0 && (
            <div class="meta-card">
              <h3 class="meta-label">Tools</h3>
              <div class="meta-list">
                {project.data.tools.map((tool: string) => (
                  <span class="meta-item">{tool}</span>
                ))}
              </div>
            </div>
          )
        }

        <!-- Tags -->
        {
          project.data.tags && project.data.tags.length > 0 && (
            <div class="meta-card">
              <h3 class="meta-label">Tags</h3>
              <div class="meta-list">
                {project.data.tags.map((tag: string) => (
                  <span class="meta-item">{tag}</span>
                ))}
              </div>
            </div>
          )
        }

        <!-- Actions -->
        {
          project.data.url && (
            <div class="meta-card">
              <h3 class="meta-label">Actions</h3>
              <div class="meta-list">
                <a
                  href={project.data.url}
                  target="_blank"
                  class="action-link primary"
                >
                  <span>View Project</span>
                  <ArrowRight width="16" height="16" fill="currentColor" />
                </a>
              </div>
            </div>
          )
        }
      </div>
    </div>
  </section>
  <div class="wrapper">
    <Content />
  </div>
</Layout>

<style>
  .breadcrumb {
    margin-bottom: var(--space-lg);
    font-family: var(--font-family-display);
    font-size: var(--font-size-sm);
  }

  .breadcrumb a {
    color: var(--color-haystack-blue);
    text-decoration: none;
  }

  .breadcrumb a:hover {
    text-decoration: underline;
  }

  .separator {
    margin: 0 var(--space-xs);
    color: var(--color-text-muted);
  }

  .current {
    color: var(--color-text-muted);
  }

  .project-header {
    margin-bottom: var(--space-xl);
    padding-bottom: var(--space-lg);
    border-bottom: 1px solid var(--color-border);
  }

  .project-title {
    margin-bottom: var(--space-sm);
  }

  .project-meta {
    display: flex;
    gap: var(--space-md);
    font-family: var(--font-family-display);
  }

  .project-year {
    color: var(--color-text-muted);
    font-weight: var(--font-weight-medium);
  }

  .project-category {
    background: var(--color-haystack-seafoam-green);
    color: var(--color-haystack-navy);
    padding: var(--space-xs) var(--space-sm);
    border-radius: var(--radius-sm);
    font-size: var(--font-size-sm);
    font-weight: var(--font-weight-medium);
  }

  /* Project Metadata */
  .project-meta-section {
    display: flex;
    flex-direction: column;
    gap: var(--space-lg);
    margin-bottom: var(--space-xl);
  }

  .meta-card {
    background: transparent;
    max-width: 450px;
    border: 1px solid var(--color-haystack-light-seafoam-green-transparent);
    border-radius: var(--radius-lg);
    padding: var(--space-md);
    transition: var(--transition-normal);
  }

  .meta-label {
    margin: 0 0 var(--space-sm) 0;
    font-family: var(--font-family-display);
    font-size: var(--font-size-sm);
    font-weight: var(--font-weight-semibold);
    color: var(--color-text-muted);
    text-transform: uppercase;
    letter-spacing: 0.05em;
  }

  .meta-list {
    display: flex;
    flex-wrap: wrap;
    gap: var(--space-xs);
  }

  .meta-item {
    background: var(--color-haystack-seafoam-green);
    color: var(--color-haystack-navy);
    padding: var(--space-xs) var(--space-sm);
    border-radius: var(--radius-sm);
    font-size: var(--font-size-xs);
    font-weight: var(--font-weight-medium);
  }

  .participants-list {
    display: flex;
    flex-wrap: wrap;
    gap: var(--space-xs);
  }

  .participant-link {
    background: var(--color-haystack-blue);
    color: white;
    padding: var(--space-xs) var(--space-sm);
    border-radius: var(--radius-sm);
    font-size: var(--font-size-xs);
    font-weight: var(--font-weight-medium);
    text-decoration: none;
    transition: var(--transition-normal);
  }

  .participant-link:hover {
    background: var(--color-haystack-navy);
  }

  .action-link {
    display: inline-flex;
    align-items: center;
    gap: var(--space-xs);
    padding: var(--space-sm) var(--space-md);
    border-radius: var(--radius-lg);
    font-family: var(--font-family-display);
    font-size: var(--font-size-sm);
    font-weight: var(--font-weight-medium);
    text-decoration: none;
    transition: var(--transition-normal);
    border: 1px solid var(--color-border);
    background: var(--color-surface);
    color: var(--color-text-primary);
  }

  .action-link.primary {
    background: var(--color-haystack-seafoam-green);
    color: var(--color-haystack-navy);
    border-color: var(--color-haystack-seafoam-green);
  }

  .action-link:hover {
    transform: translateY(-2px);
    box-shadow: var(--shadow-md);
    border-color: var(--color-haystack-seafoam-green);
  }

  .action-link.primary:hover {
    background: var(--color-haystack-light-seafoam-green);
  }

  .action-link svg {
    transition: var(--transition-normal);
  }

  .action-link:hover svg {
    transform: translateX(2px);
  }

  @media (max-width: 768px) {
    .project-meta {
      flex-direction: column;
      gap: var(--space-sm);
    }

    .project-meta-section {
      gap: var(--space-md);
    }

    .meta-card {
      max-width: none;
    }
  }
</style>
