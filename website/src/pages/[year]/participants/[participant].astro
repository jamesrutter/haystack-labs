---
import LayoutParticipant from "@/layouts/layout-participant.astro";
import { getCollection, render } from "astro:content";

export async function getStaticPaths() {
  const participants = await getCollection("participants");
  return participants.map((participant) => {
    const [year, , participantSlug] = participant.id.split("/");
    return {
      params: {
        year: year,
        participant: participantSlug,
      },
      props: { participant, year },
    };
  });
}

const { participant, year } = Astro.props;
const { Content } = await render(participant);

// Get related projects for this participant
const allProjects = await getCollection("projects", ({ id }) =>
  id.startsWith(`${year}/`)
);

// Filter projects that include this participant in contributors or match by name
const participantSlug = participant.id.split("/").pop();
const relatedProjects = allProjects.filter(
  (project) =>
    project.data.contributors?.includes(participantSlug) ||
    participant.data.projects?.includes(project.id.split("/").pop())
);
---

<LayoutParticipant
  title={`${participant.data.name} - Haystack Labs ${year}`}
  description={`Profile of ${participant.data.name} for Haystack Labs ${year}.`}
>
  <div class="wrapper">
    <nav class="breadcrumb">
      <a href={`/${year}`}>{year}</a>
      <span class="separator">/</span>
      <a href={`/${year}/participants`}>Participants</a>
      <span class="separator">/</span>
      <span class="current">{participant.data.name}</span>
    </nav>

    <header class="participant-header">
      <h1 class="participant-name">{participant.data.name}</h1>
      <div class="participant-meta">
        {
          participant.data.type && (
            <span class="participant-type">{participant.data.type}</span>
          )
        }
        <span class="participant-year">Haystack Labs {year}</span>
      </div>

      <div class="participant-contact">
        {
          participant.data.email && (
            <a href={`mailto:${participant.data.email}`} class="contact-link">
              {participant.data.email}
            </a>
          )
        }
        {
          participant.data.website && (
            <a
              href={participant.data.website}
              target="_blank"
              rel="noopener noreferrer"
              class="contact-link"
            >
              Website
            </a>
          )
        }
      </div>
    </header>

    {
      relatedProjects.length > 0 && (
        <section class="related-projects">
          <h2>Projects</h2>
          <div class="projects-grid">
            {relatedProjects.map((project) => {
              const projectSlug = project.id.split("/").pop();
              return (
                <a
                  href={`/${year}/projects/${projectSlug}`}
                  class="project-card"
                >
                  <h3>{project.data.title}</h3>
                  {project.data.category && (
                    <span class="project-category">
                      {project.data.category}
                    </span>
                  )}
                </a>
              );
            })}
          </div>
        </section>
      )
    }

    <div class="content">
      <Content />
    </div>
  </div>
</LayoutParticipant>

<style>
  .breadcrumb {
    margin-bottom: var(--space-lg);
    font-family: var(--font-family-display);
    font-size: var(--font-size-sm);
  }

  .breadcrumb a {
    color: var(--color-haystack-blue);
    text-decoration: none;
  }

  .breadcrumb a:hover {
    text-decoration: underline;
  }

  .separator {
    margin: 0 var(--space-xs);
    color: var(--color-text-muted);
  }

  .current {
    color: var(--color-text-muted);
  }

  .participant-header {
    margin-bottom: var(--space-3xl);
    padding-bottom: var(--space-lg);
    border-bottom: 1px solid var(--color-border);
  }

  .participant-name {
    margin-bottom: var(--space-sm);
  }

  .participant-meta {
    display: flex;
    gap: var(--space-md);
    margin-bottom: var(--space-md);
    font-family: var(--font-family-display);
  }

  .participant-type {
    background: var(--color-haystack-seafoam-green);
    color: var(--color-haystack-navy);
    padding: var(--space-xs) var(--space-sm);
    border-radius: var(--radius-sm);
    font-size: var(--font-size-sm);
    font-weight: var(--font-weight-medium);
    text-transform: capitalize;
  }

  .participant-year {
    color: var(--color-text-muted);
    font-weight: var(--font-weight-medium);
  }

  .participant-contact {
    display: flex;
    gap: var(--space-md);
  }

  .contact-link {
    color: var(--color-haystack-blue);
    text-decoration: none;
    font-family: var(--font-family-display);
    font-weight: var(--font-weight-medium);
  }

  .contact-link:hover {
    text-decoration: underline;
  }

  .related-projects {
    margin-bottom: var(--space-3xl);
  }

  .related-projects h2 {
    margin-bottom: var(--space-lg);
  }

  .projects-grid {
    display: grid;
    grid-template-columns: repeat(auto-fit, minmax(250px, 1fr));
    gap: var(--space-md);
  }

  .project-card {
    display: block;
    text-decoration: none;
    background: var(--color-haystack-navy-tint-10);
    border: 1px solid var(--color-haystack-light-seafoam-green-transparent);
    border-radius: var(--radius-lg);
    padding: var(--space-md);
    transition: all var(--transition-normal);
  }

  .project-card:hover {
    transform: translateY(-2px);
    box-shadow: var(--shadow-md);
    border-color: var(--color-haystack-blue);
  }

  .project-card h3 {
    margin: 0 0 var(--space-xs) 0;
    color: var(--color-text-primary);
    font-size: var(--font-size-md);
    transition: color var(--transition-normal);
  }

  .project-card:hover h3 {
    color: var(--color-haystack-blue);
  }

  .project-category {
    font-size: var(--font-size-sm);
    color: var(--color-text-muted);
    font-weight: var(--font-weight-medium);
  }

  .content {
    max-width: 800px;
  }

  @media (max-width: 768px) {
    .participant-meta {
      flex-direction: column;
      gap: var(--space-sm);
    }

    .participant-contact {
      flex-direction: column;
      gap: var(--space-sm);
    }

    .projects-grid {
      grid-template-columns: 1fr;
    }
  }
</style>
