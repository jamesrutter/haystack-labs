      import Layout from "@/layouts/layout.astro";
import { getCollection } from "astro:content";
import ArrowRight from "@/assets/arrow-right.svg";

export async function getStaticPaths() {
  const years = await getCollection("years");
  return years.map((year) => ({
    params: { year: year.data.year.toString() },
    props: { year },
  }));
}

const { year } = Astro.props;

// Get participants for this specific year
const participants = await getCollection("participants", ({ id }) =>
  id.startsWith(`${year.data.year}/`)
);

const sorted_participants = participants.sort((a, b) =>
  a.data.name.localeCompare(b.data.name)
);

<Layout
  title={`${year.data.year} Participants - Haystack Labs`}
  description={`Participants from Haystack Labs ${year.data.year}`}
>
  <section class="section">
    <div class="wrapper">
      <div class="page-header">
        <nav class="breadcrumb">
          <a href={`/${year.data.year}`}>{year.data.year}</a>
          <span class="separator">/</span>
          <span class="current">Participants</span>
        </nav>
        <h1 class="title">
          {year.data.year} Participants
          <span class="count">({sorted_participants.length})</span>
        </h1>
        <p class="description">
          Meet the {sorted_participants.length} participants from Haystack Labs {year.data.year}
        </p>
      </div>

      <div class="grid-auto">
        {
          sorted_participants.map((participant) => {
            const participantSlug = participant.id.split("/").pop();
            return (
              <a
                href={`/${year.data.year}/participants/${participantSlug}`}
                class="participant-card"
              >
                <div class="participant-card__content">
                  <div class="participant-info">
                    <h3 class="participant-card__name">
                      {participant.data.name}
                    </h3>
                    {participant.data.type && (
                      <span class="participant-type">
                        {participant.data.type}
                      </span>
                    )}
                  </div>
                  <div class="participant-card__arrow">
                    <ArrowRight width="20" height="20" fill="currentColor" />
                  </div>
                </div>
              </a>
            );
          })
        }
      </div>
    </div>
  </section>
</Layout>

